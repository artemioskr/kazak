# Скопируй в .env и заполни. .env в гит не коммитится.

# Домен, на который смотрит A-запись VPS (для теста можно оставить localhost)
APP_DOMAIN=localhost

# База: пароль придумай длинный, менять потом больно
DB_NAME=fishcast
DB_USER=fishcast
DB_PASS=

# Секрет подписи токенов: openssl rand -hex 32
APP_SECRET=

# Токен бота от @BotFather (для входа через Telegram).
# У бота: /setdomain -> домен из APP_DOMAIN. Пусто = вход выключен.
TELEGRAM_BOT_TOKEN=

# Откуда разрешать запросы к API кроме своего домена (фронт на Pages), через запятую
CORS_ORIGINS=https://artemioskr.github.io

# TTL кэша погоды, сек
WEATHER_TTL_SEC=1800
